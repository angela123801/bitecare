# ============================================================
# BiteCare — Environment Variables
# ============================================================
# Copy this file to .env and fill in your Supabase credentials.
#
#   cp .env.example .env
#
# For HOSTED Supabase (production / remote development):
#   Get the values from your Supabase Dashboard > Settings > API.
#
# For LOCAL Supabase development:
#   Copy .env.local.example to .env.local instead.
#   Vite loads .env.local with higher priority than .env,
#   so both files can coexist safely.
#
# .env is gitignored. Never commit it.
# ============================================================

# ------------------------------------------------------------
# Browser variables (public by design)
# ------------------------------------------------------------
# These two are compiled into the browser bundle. That is safe:
# the anon key is a public key, and access to data is controlled
# by Row Level Security in the database, not by hiding the key.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================================
# Server-side secrets — SMS gateway for verification codes
# ============================================================
# These are read by the `otp` edge function as server-side
# secrets. Add them in the Supabase Dashboard under
# Project Settings > Edge Functions > Secrets.
#
# NEVER put these in a VITE_ variable: anything prefixed VITE_
# is shipped to the browser and would leak the key.
#
# BiteCare sends verification codes by SMS only. If no gateway
# is configured the app still runs and states plainly that
# delivery is unavailable — it never pretends a message was
# sent.
#
# At least one gateway must be configured for sign-in, account
# registration and password reset to work.

# --- SMS Gateway for Android (free, open source; used first when a
#     password is set) ---
# Sends through your own Android phone with no monthly message cap.
# Install "SMS Gateway for Android" (sms-gate.app), open
# Settings > Credentials and note the username and password it shows,
# then note the device id on the Devices screen.
#
# SMSGATE_DEVICE_ID pins the sending phone. When it is left blank the
# most recently active phone is used, and any phone that has not
# checked in for 12 hours is ignored.
#
# SMSGATE_URL points at the cloud server by default. Change it only if
# you run your own server, or a local one on the same network as the
# phone — a hosted function cannot reach a phone on your home Wi-Fi.
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMSGATE_DEVICE_ID=
SMSGATE_URL=https://api.sms-gate.app

# --- TextBee (free) — the gateway that sends the codes ---
# Sends through an Android phone paired with your account.
# Create an API key at https://textbee.dev, install their
# Android app on the gateway phone, then optionally pin a
# device with TEXTBEE_DEVICE_ID (otherwise the most recently
# active phone is used).
#
# TEXTBEE_SIM_ID selects which SIM in the gateway phone sends
# the messages. The phone's default SIM is used when unset.
# Android reassigns these ids when a SIM is swapped, so read
# the current value from the SIM Cards screen in the app.
TEXTBEE_API_KEY=your_textbee_api_key
TEXTBEE_DEVICE_ID=
TEXTBEE_SIM_ID=

# --- Semaphore (Philippine SMS provider, pay per credit) ---
# Used only if SMSGate and TextBee are not configured.
SEMAPHORE_API_KEY=your_semaphore_api_key
SEMAPHORE_SENDER_NAME=BiteCare

# --- Twilio ---
# Used only if none of the above are configured.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# --- Vonage ---
# Used only if none of the above are configured.
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret
VONAGE_FROM=BiteCare

# ============================================================
# Note on email
# ============================================================
# BiteCare verifies accounts by SMS only. Email one-time codes
# are not used, so no email provider key is required.
# Supabase Auth still uses email addresses as the account
# identifier internally, but no verification email is sent.
