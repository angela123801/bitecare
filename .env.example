# ============================================================
# BiteCare — Environment Variables
# ============================================================
# Copy this file to .env and fill in your Supabase credentials.
#
# For HOSTED Supabase (production / remote development):
#   Get these from your Supabase Dashboard > Settings > API.
#
# For LOCAL Supabase development:
#   Copy .env.local.example to .env.local instead.
#   Vite loads .env.local with higher priority than .env,
#   so both files can coexist safely.
# ============================================================

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================================
# OTP delivery providers (set on the Supabase project, NOT in the browser)
# ============================================================
# These are read by the `otp` edge function as server-side secrets. Add them
# under Supabase Dashboard > Project Settings > Edge Functions > Secrets.
# NEVER put these in a VITE_ variable: anything prefixed VITE_ is shipped to
# the browser and would leak the key.
#
# If a provider is not configured, the app still works and states clearly that
# delivery is unavailable. It never pretends a message was sent.

# --- Email (Resend) ---
# Used for staff accounts (email OTP).
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=BiteCare <no-reply@yourdomain.com>

# --- SMS (choose one; TextBee is used first if present) ---
# TextBee — free: sends through an Android phone paired with your account.
# Create an API key in the textbee.dev dashboard, install their Android app on
# the gateway phone, then optionally pin a device with TEXTBEE_DEVICE_ID
# (otherwise the most recently active phone is used).
TEXTBEE_API_KEY=your_textbee_api_key
TEXTBEE_DEVICE_ID=

# Semaphore — Philippine SMS provider (pay per credit)
SEMAPHORE_API_KEY=your_semaphore_api_key
SEMAPHORE_SENDER_NAME=BiteCare

# Twilio — used only if neither TextBee nor Semaphore is set
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Vonage — used only if none of the above are set
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret
VONAGE_FROM=BiteCare

# ============================================================
# BiteCare — Firebase (legacy; no longer used by the running app)
# These are PUBLIC web config values (not secrets). They are safe
# to ship in the client bundle; access is controlled by Security Rules.
# ============================================================
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
